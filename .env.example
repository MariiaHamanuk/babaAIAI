OPENAI_API_KEY=
ACCESS_PASSWORD=change-me
AUTH_SECRET=run-openssl-rand-base64-48
USE_MOCKS=1

# Set to 1 to disable in-memory cache + warm-start fixtures so every refresh
# hits OpenAI fresh. Useful for end-to-end testing.
DISABLE_CACHE=0

# mock-domain (default) reads seed.ts directly. mock-api parses real-shaped fixture
# JSON via the .real adapters. real makes live HTTP calls.
INTEGRATIONS_MODE=mock-domain

# Required only when INTEGRATIONS_MODE=real
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
HUBSPOT_PORTAL_ID=
HUBSPOT_ACCESS_TOKEN=
