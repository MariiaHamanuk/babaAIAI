/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
ehthumbs.db
*.pem

# editor backups + swap
*.swp
*.swo
*~
*.bak
*.tmp

# IDE / editor configs
.vscode/
.idea/
*.iml
*.suo
*.ntvs*
*.njsproj
*.sln

# debug + logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env*.local

# vercel + build caches
.vercel
.turbo
.swc

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code
.claude

# generated / out-of-band reference docs
DATA.md
DATA.pdf
SETUP.md
SETUP.pdf

